# Use official Node.js LTS image
FROM node:26

# Set working directory
WORKDIR /app

# Copy only dependency files first to leverage Docker layer caching
COPY package*.json ./

# Install dependencies (runs during build)
RUN npm install

# Copy the rest of the application code
COPY . .

# Expose port (change if your framework uses a different default, e.g., 5173 for Vite)
EXPOSE 5173

ENV NODE_ENV=development

# Run the dev server
CMD ["npm", "run", "dev"]